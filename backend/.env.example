# Copy to backend/.env (or set as real environment variables).
RECIPIENT_EMAIL=connect@forthledger.com
MAIL_FROM=connect@forthledger.com

# Leave SMTP_HOST empty to run in "console" mode: emails are written
# to backend/data/outbox.log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
